<?xml version="1.0" encoding="UTF-8"?>
<!--
  Cấu hình IIS cho Tạp Hóa POS tại ipos123.vn (site tĩnh, không cần ARR/proxy).
  Đây là bản dịch của Caddyfile sang IIS — server production chạy Windows +
  IIS, không phải Docker/Caddy như HOSTING.md giả định.

  Yêu cầu: module URL Rewrite (đã cài sẵn trên server, v7.2).
  File này được deploy/deploy-iis.ps1 copy vào gốc site.
-->
<configuration>
  <system.webServer>

    <staticContent>
      <!-- IIS không biết .webmanifest → trả 404, PWA không đọc được manifest -->
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <!-- Mặc định cho file không khớp <location> nào bên dưới -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- 1. ACME challenge phải đi thẳng, không redirect, không SPA fallback,
             nếu không win-acme/Certify sẽ không xin được cert. -->
        <rule name="ACME challenge passthrough" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*" />
          <action type="None" />
        </rule>

        <!-- 2. www → apex. Giữ MỘT origin duy nhất: dữ liệu bán hàng nằm trong
             IndexedDB, mà IndexedDB tách theo origin. Chạy cả hai origin thì
             kho dữ liệu offline của user bị chia đôi, đơn hàng "biến mất". -->
        <rule name="www to apex" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.ipos123\.vn$" />
          </conditions>
          <action type="Redirect" url="https://ipos123.vn/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3. HTTP → HTTPS. Camera quét mã vạch CHỈ chạy trên HTTPS. -->
        <rule name="HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 4. /api/* → Node API do PM2 nuôi trên cổng nội bộ 8210.
             Phải đứng TRƯỚC SPA fallback, nếu không mọi lời gọi API sẽ bị
             nuốt thành index.html và client nhận HTML thay vì JSON.
             Cần module ARR bật proxy ở mức máy chủ (đã dùng cho alaw.vn). -->
        <rule name="API proxy" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8210/api/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
        </rule>

        <!-- 5. SPA fallback: route không phải file/thư mục thật → index.html
             cho react-router xử lý. Dùng Rewrite (không Redirect) để giữ URL. -->
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- camera=(self) bắt buộc để quét mã vạch chạy được -->
        <add name="Permissions-Policy" value="camera=(self), microphone=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".env" />
          <add segment="package.json" />
          <add segment="package-lock.json" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true">
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".map" allowed="false" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

  </system.webServer>

  <!-- ===== Cache strategy — khớp với Caddyfile, đừng đổi nếu chưa hiểu ===== -->

  <!-- Vite hash tên file trong /assets/* nên cache vĩnh viễn an toàn -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="365.00:00:00"
                     cacheControlCustom="immutable" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- index.html phải fresh để user thấy bản mới nhất sau mỗi deploy -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Service worker phải fresh để user nhận update PWA -->
  <location path="sw.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="registerSW.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Manifest + icon: cache vừa phải (1 ngày) -->
  <location path="manifest.webmanifest">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
