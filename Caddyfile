# Caddy config cho Tạp Hóa POS
# Domain production: ipos123.vn (lấy từ biến DOMAIN, xem .env.example)
# Đổi domain bằng cách set biến trong docker-compose.yml hoặc .env

# www → apex (301). Bắt buộc giữ MỘT origin duy nhất: dữ liệu bán hàng nằm
# trong IndexedDB, mà IndexedDB tách theo origin. Nếu user vào lúc www lúc
# apex thì kho dữ liệu offline bị chia đôi — đơn hàng "biến mất".
# Yêu cầu: phải có A record cho www, nếu không Caddy xin cert www sẽ fail
# (apex vẫn chạy bình thường, chỉ log lỗi).
{$DOMAIN_WWW:www.ipos123.vn} {
	redir https://{$DOMAIN:ipos123.vn}{uri} permanent
}

{$DOMAIN:ipos123.vn} {
	# Auto HTTPS - Caddy tự xin Let's Encrypt cert
	# Email cho Let's Encrypt: set qua biến ACME_EMAIL nếu muốn
	# Bỏ comment dòng dưới nếu cần
	# tls {$ACME_EMAIL}

	root * /srv

	# Compress mọi response - quan trọng cho 4G/3G ở VN
	encode zstd gzip

	# ===== Cache strategy =====
	# Vite hash file name trong /assets/* nên cache vĩnh viễn an toàn
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Service worker và register - phải fresh để user nhận update PWA
	@sw path /sw.js /registerSW.js /workbox-*.js
	header @sw {
		Cache-Control "no-cache, no-store, must-revalidate"
		Pragma "no-cache"
	}

	# index.html - không cache để user thấy bản mới nhất
	@html path /index.html /
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	# Manifest và icon - cache vừa phải
	@meta path /manifest.webmanifest /favicon.svg /icon-*.png
	header @meta Cache-Control "public, max-age=86400"

	# ===== Security headers =====
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=()"
		# Strict-Transport-Security có sẵn từ Caddy khi dùng HTTPS
		-Server
	}

	# ===== SPA routing =====
	# Mọi route không phải file thật → trả về index.html
	# để react-router xử lý
	try_files {path} /index.html

	file_server
}
