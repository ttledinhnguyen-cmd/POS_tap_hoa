# Sao chép file này thành .env.local (máy dev) hoặc .env (server production)
# cp .env.example .env.local
#
# LƯU Ý: trên server production dùng tên `.env` — docker compose đọc file này
# để lấy cả biến build (VITE_*) lẫn biến hosting (DOMAIN, ACME_EMAIL).

# === API backend ===
# Bỏ trống = cùng origin (/api). Chỉ set khi chạy frontend tách khỏi server.
VITE_API_URL=

# === Support contact (client, hiển thị trong UI) ===
# Số Zalo + email support — hiện ở SubscriptionExpiredPage, Settings,
# mobile "Thêm" sheet, signup notice. Zalo deep link via https://zalo.me/{phone}.
VITE_SUPPORT_ZALO=0901234567
VITE_SUPPORT_EMAIL=support@ipos123.vn
VITE_BUSINESS_NAME=POS Tạp Hóa Co.

# === Goong Maps (client, hiển thị bản đồ shops + autocomplete địa chỉ) ===
# Đăng ký free tại https://account.goong.io/ — 1000 req/ngày miễn phí.
# Restrict theo HTTP Referrer trong Goong dashboard cho production:
#   https://ipos123.vn/*
VITE_GOONG_API_KEY=

# === Hosting (chỉ dùng cho docker-compose deploy) ===
# Domain trỏ vào server này. Phải có DNS A record trỏ về IP server TRƯỚC khi
# start container, nếu không Let's Encrypt sẽ fail.
# Cần CẢ HAI record: apex (@) và www — Caddy xin cert cho cả hai.
DOMAIN=ipos123.vn
DOMAIN_WWW=www.ipos123.vn

# Email cho Let's Encrypt (tùy chọn nhưng nên có để nhận thông báo cert sắp hết)
ACME_EMAIL=admin@ipos123.vn
